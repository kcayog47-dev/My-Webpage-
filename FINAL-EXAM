    <!-- JAVASCRIPT: IT QUIZ -->
    <script>
        const questions = [
            {
                question: "What does CPU stand for?",
                answers: [
                    "Central Processing Unit",
                    "Computer Personal Unit",
                    "Central Program Utility",
                    "Control Processing User"
                ],
                correct: 0
            },
            {
                question: "Which language is commonly used to create web pages?",
                answers: [
                    "Java",
                    "HTML",
                    "Python",
                    "C++"
                ],
                correct: 1
            },
            {
                question: "Which device is used to type information?",
                answers: [
                    "Monitor",
                    "Speaker",
                    "Keyboard",
                    "Printer"
                ],
                correct: 2
            },
            {
                question: "What does RAM stand for?",
                answers: [
                    "Random Access Memory",
                    "Read Access Machine",
                    "Run All Memory",
                    "Rapid Application Mode"
                ],
                correct: 0
            },
            {
                question: "Which one is an example of an operating system?",
                answers: [
                    "Google Chrome",
                    "Microsoft Word",
                    "Windows",
                    "HTML"
                ],
                correct: 2
            }
        ];

        let currentQuestion = 0;
        let score = 0;
        let answered = false;

        const questionElement = document.getElementById("question");
        const answerButtons = document.getElementById("answerButtons");
        const feedbackElement = document.getElementById("feedback");
        const scoreElement = document.getElementById("score");

        const startButton = document.getElementById("startButton");
        const nextButton = document.getElementById("nextButton");
        const restartButton = document.getElementById("restartButton");

        const rewardBox = document.getElementById("rewardBox");
        const tryAgainBox = document.getElementById("tryAgainBox");

        // START QUIZ
        function startQuiz() {
            currentQuestion = 0;
            score = 0;
            answered = false;

            startButton.hidden = true;
            restartButton.hidden = true;
            nextButton.hidden = true;

            rewardBox.style.display = "none";
            tryAgainBox.style.display = "none";

            showQuestion();
        }

        // SHOW QUESTION
        function showQuestion() {
            answered = false;

            const current = questions[currentQuestion];

            questionElement.textContent =
                "Question " + (currentQuestion + 1) +
                ": " + current.question;

            answerButtons.innerHTML = "";
            feedbackElement.textContent = "";

            scoreElement.textContent =
                "Score: " + score + " / " + questions.length;

            current.answers.forEach(function(answer, index) {
                const button = document.createElement("button");

                button.textContent = answer;
                button.className = "game-button";

                button.onclick = function() {
                    checkAnswer(index);
                };

                answerButtons.appendChild(button);
            });
        }

        // CHECK ANSWER
        function checkAnswer(selected) {
            if (answered) {
                return;
            }

            answered = true;

            const correctAnswer = questions[currentQuestion].correct;
            const buttons = answerButtons.querySelectorAll("button");

            buttons.forEach(function(button) {
                button.disabled = true;
            });

            if (selected === correctAnswer) {
                score++;
                feedbackElement.textContent = "Correct! Great job!";
            } else {
                feedbackElement.textContent =
                    "Incorrect! The correct answer is: " +
                    questions[currentQuestion].answers[correctAnswer];
            }

            scoreElement.textContent =
                "Score: " + score + " / " + questions.length;

            nextButton.hidden = false;

            nextButton.textContent =
                currentQuestion === questions.length - 1
                ? "See Result"
                : "Next Question";
        }

        // NEXT QUESTION
        function nextQuestion() {
            currentQuestion++;

            if (currentQuestion < questions.length) {
                showQuestion();
            } else {
                showResult();
            }
        }

        // SHOW FINAL RESULT AND REWARD
        function showResult() {
            questionElement.textContent = "Quiz Completed!";

            answerButtons.innerHTML = "";

            feedbackElement.textContent =
                "You got " + score + " out of " +
                questions.length + " correct answers!";

            scoreElement.textContent =
                "Final Score: " + score + " / " + questions.length;

            nextButton.hidden = true;
            restartButton.hidden = false;

            if (score === questions.length) {
                rewardBox.style.display = "block";
                tryAgainBox.style.display = "none";
            } else {
                rewardBox.style.display = "none";
                tryAgainBox.style.display = "block";
            }
        }
    </script>

