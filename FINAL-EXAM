<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Personal Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f6fa;
            color: #222;
            line-height: 1.6;
        }

        /* NAVIGATION */
        header {
            background: #14213d;
            color: white;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        header h2 {
            color: #fca311;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 8px;
            font-weight: bold;
        }

        nav a:hover {
            color: #fca311;
        }

        /* HOME */
        .home {
            min-height: 400px;
            background: linear-gradient(135deg, #14213d, #30466e);
            color: white;
            text-align: center;
            padding: 100px 20px;
        }

        .home h1 {
            font-size: 40px;
            color: #fca311;
        }

        .home p {
            margin: 15px 0;
        }

        .main-button {
            display: inline-block;
            background: #fca311;
            color: #14213d;
            padding: 12px 25px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            margin-top: 15px;
        }

        .main-button:hover {
            background: white;
        }

        /* SECTIONS */
        section {
            padding: 55px 8%;
        }

        section h2 {
            text-align: center;
            color: #14213d;
            margin-bottom: 25px;
            font-size: 28px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
            margin-bottom: 20px;
        }

        .card h3 {
            color: #14213d;
            margin-bottom: 10px;
        }

        /* SKILLS */
        .skill-list {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .skill {
            background: #14213d;
            color: white;
            padding: 12px 22px;
            border-radius: 20px;
        }

        /* IT QUIZ GAME */
        .game-card {
            max-width: 650px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 3px 12px rgba(0,0,0,0.1);
        }

        .game-card h3 {
            color: #14213d;
            font-size: 24px;
            margin-bottom: 10px;
        }

        .game-area {
            margin-top: 20px;
        }

        #question {
            font-size: 20px;
            font-weight: bold;
            margin: 20px 0;
        }

        .answer-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .game-button {
            background: #14213d;
            color: white;
            border: none;
            padding: 13px;
            border-radius: 7px;
            cursor: pointer;
            font-size: 15px;
            transition: 0.3s;
        }

        .game-button:hover {
            background: #fca311;
            color: #14213d;
        }

        .game-button:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        .game-buttons {
            margin-top: 20px;
            display: flex;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .game-button.secondary {
            background: #fca311;
            color: #14213d;
        }

        #feedback {
            font-weight: bold;
            margin-top: 15px;
        }

        .score {
            color: #14213d;
            font-weight: bold;
            margin-top: 15px;
        }

        /* SPECIAL GIFT REWARD */
        .reward-box {
            display: none;
            background: #fff8e7;
            border: 2px solid #fca311;
            border-radius: 12px;
            padding: 25px;
            margin-top: 25px;
            animation: popUp 0.7s ease;
        }

        .reward-box h2 {
            color: #d48806;
            margin-bottom: 10px;
        }

        .gift-icon {
            font-size: 70px;
            margin: 10px;
        }

        .reward-box p {
            margin: 10px 0;
        }

        .reward-title {
            color: #14213d;
            font-size: 22px;
            font-weight: bold;
        }

        @keyframes popUp {
            from {
                transform: scale(0.7);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        /* JAVA CODE */
        pre {
            background: #14213d;
            color: #fca311;
            padding: 20px;
            border-radius: 8px;
            overflow-x: auto;
            font-size: 14px;
        }

        /* FOOTER */
        footer {
            background: #14213d;
            color: white;
            text-align: center;
            padding: 20px;
        }

        /* MOBILE RESPONSIVE */
        @media (max-width: 600px) {
            header {
                justify-content: center;
                text-align: center;
                gap: 12px;
            }

            nav a {
                display: inline-block;
                font-size: 13px;
            }

            .home h1 {
                font-size: 30px;
            }

            .answer-buttons {
                grid-template-columns: 1fr;
            }

            section {
                padding: 40px 5%;
            }
        }
    </style>
</head>

